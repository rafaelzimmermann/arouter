{
  "title": "arouter",
  "uid": "arouter",
  "tags": [
    "arouter",
    "llm-router"
  ],
  "timezone": "utc",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0
      },
      {
        "name": "caller",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(arouter_requests_total, caller)",
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Requests (5m)",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(rate(arouter_requests_total{caller=~\"$caller\",event=\"request\"}[5m]))"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Spend (24h)",
      "description": "Estimated USD \u2014 priced (ondemand) models only",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(increase(arouter_cost_usd_total{caller=~\"$caller\"}[24h]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        }
      }
    },
    {
      "type": "stat",
      "title": "In flight",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "max(arouter_requests_in_flight)"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Degraded serves (1h)",
      "description": "Requests served below the requested grade",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(increase(arouter_requests_degraded_total{caller=~\"$caller\"}[1h]))"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Stream TTFB p95",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(arouter_stream_ttfb_seconds_bucket[10m])))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "type": "stat",
      "title": "Uptime",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "max(arouter_uptime_seconds)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Requests/s by pool",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (pool) (rate(arouter_requests_total{caller=~\"$caller\",event=\"request\"}[5m]))",
          "legendFormat": "{{pool}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Tokens/s by model and direction",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (model, direction) (rate(arouter_tokens_total[5m]))",
          "legendFormat": "{{model}} {{direction}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Quota window utilization",
      "description": "Per provider and window, from aitop snapshots (100 = exhausted)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "max by (provider, window) (arouter_quota_window_pct)",
          "legendFormat": "{{provider}} {{window}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            },
            "thresholds": {
              "steps": []
            }
          },
          "max": 100
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Drain countdown (use-it-or-lose-it)",
      "description": "Seconds until a draining window resets; flat -1 = not draining",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "max by (provider) (arouter_quota_drain_reset_secs)",
          "legendFormat": "{{provider}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Spend/s by caller",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (caller) (rate(arouter_cost_usd_total{caller=~\"$caller\"}[5m])) * 3600",
          "legendFormat": "{{caller}} (USD/h)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Latency p50/p95",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(arouter_request_duration_seconds_bucket[10m])))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(arouter_request_duration_seconds_bucket[10m])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "HTTP errors/s by source → target",
      "description": "Client-facing 4xx/5xx responses. source_model is the requested model; target_model is the selected upstream or none when routing exhausted.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 28
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (http_status, source_model, target_model) (rate(arouter_requests_total{caller=~\"$caller\",event=\"request\",http_status=~\"4..|5..\"}[5m]))",
          "legendFormat": "{{http_status}} {{source_model}} → {{target_model}}"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "version": 1
}
